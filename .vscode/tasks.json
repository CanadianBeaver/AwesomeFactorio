{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docusaurus install",
            "type": "shell",
            "command": "npm clean-install",
            "options": {
                "cwd": "${workspaceRoot}/website",
                "shell": {
                   "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Docusaurus clear",
            "type": "npm",
            "script": "clear",
            "promptOnClose": false,
            "options": {
                "cwd": "${workspaceRoot}/website",
                "shell": {
                   "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docusaurus upgrade",
            "type": "shell",
            "command": "npm upgrade",
            "options": {
                "cwd": "${workspaceRoot}/website",
                "shell": {
                   "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Docusaurus build",
            "type": "npm",
            "script": "build",
            "promptOnClose": false,
            "options": {
                "cwd": "${workspaceRoot}/website",
                "shell": {
                   "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Docusaurus serve",
            "type": "npm",
            "script": "serve",
            "promptOnClose": false,
            "options": {
                "cwd": "${workspaceRoot}/website",
                "shell": {
                   "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}